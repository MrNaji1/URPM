#: urpm/cli.py
#, python-brace-format
msgid ""
"URPM {version}: every package on your computer, in one place\n"
"\n"
"usage: urpm [command] [options]\n"
"\n"
"  (no command)          open the URPM window\n"
"  list                  list packages   --mine  --updates  --source ID  --json\n"
"  search WORDS…         find packages by name or description\n"
"  info NAME             everything about one package\n"
"  updates               check for updates (🛡 marks security fixes)\n"
"  dupes                 apps installed more than once\n"
"  clean                 what can be cleaned up and how much space it frees\n"
"                        (shows the commands; nothing is removed)\n"
"  history               what was installed, updated or removed   --days N\n"
"  export FILE           save the list as .csv, .json or .txt\n"
"  backup FILE           save the apps you installed, to move to a new computer\n"
"                        (also writes FILE.sh, a script that reinstalls them)\n"
"  restore FILE          show what's missing on this computer   --install to install it\n"
"\n"
"  --check-updates       check once and notify about new updates (for timers)\n"
"  --install-desktop     add URPM to your app menu (for pip / pipx installs)\n"
"  --uninstall-desktop   remove it from your app menu again\n"
"  --version             print the version\n"
"  -h, --help            show this help\n"
msgstr ""
"URPM {version}: todos los paquetes de tu equipo, en un solo lugar\n"
"\n"
"uso: urpm [comando] [opciones]\n"
"\n"
"  (sin comando)         abre la ventana de URPM\n"
"  list                  lista los paquetes   --mine  --updates  --source ID  --json\n"
"  search WORDS…         busca paquetes por nombre o descripción\n"
"  info NAME             todo sobre un paquete\n"
"  updates               busca actualizaciones (🛡 marca las de seguridad)\n"
"  dupes                 apps instaladas más de una vez\n"
"  clean                 qué se puede limpiar y cuánto espacio libera\n"
"                        (muestra los comandos; no se elimina nada)\n"
"  history               qué se instaló, actualizó o eliminó   --days N\n"
"  export FILE           guarda la lista como .csv, .json o .txt\n"
"  backup FILE           guarda las apps que instalaste, para llevarlas a un equipo nuevo\n"
"                        (también crea FILE.sh, un script que las reinstala)\n"
"  restore FILE          muestra lo que falta en este equipo   --install para instalarlo\n"
"\n"
"  --check-updates       comprueba una vez y avisa de actualizaciones nuevas (para temporizadores)\n"
"  --install-desktop     añade URPM a tu menú de apps (para instalaciones con pip / pipx)\n"
"  --uninstall-desktop   lo quita otra vez de tu menú de apps\n"
"  --version             muestra la versión\n"
"  -h, --help            muestra esta ayuda\n"

