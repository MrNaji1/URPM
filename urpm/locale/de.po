#: urpm/cli.py
#, python-brace-format
msgid ""
"URPM {version}: every package on your computer, in one place\n"
"\n"
"usage: urpm [command] [options]\n"
"\n"
"  (no command)          open the URPM window\n"
"  list                  list packages   --mine  --updates  --source ID  --json\n"
"  search WORDS…         find packages by name or description\n"
"  info NAME             everything about one package\n"
"  updates               check for updates (🛡 marks security fixes)\n"
"  dupes                 apps installed more than once\n"
"  clean                 what can be cleaned up and how much space it frees\n"
"                        (shows the commands; nothing is removed)\n"
"  history               what was installed, updated or removed   --days N\n"
"  export FILE           save the list as .csv, .json or .txt\n"
"  backup FILE           save the apps you installed, to move to a new computer\n"
"                        (also writes FILE.sh, a script that reinstalls them)\n"
"  restore FILE          show what's missing on this computer   --install to install it\n"
"\n"
"  --check-updates       check once and notify about new updates (for timers)\n"
"  --install-desktop     add URPM to your app menu (for pip / pipx installs)\n"
"  --uninstall-desktop   remove it from your app menu again\n"
"  --version             print the version\n"
"  -h, --help            show this help\n"
msgstr ""
"URPM {version}: alle Pakete auf deinem Computer, an einem Ort\n"
"\n"
"Aufruf: urpm [Befehl] [Optionen]\n"
"\n"
"  (kein Befehl)         das URPM-Fenster öffnen\n"
"  list                  Pakete auflisten   --mine  --updates  --source ID  --json\n"
"  search WORDS…         Pakete nach Name oder Beschreibung suchen\n"
"  info NAME             alles über ein Paket\n"
"  updates               nach Updates suchen (🛡 markiert Sicherheitskorrekturen)\n"
"  dupes                 Apps, die mehr als einmal installiert sind\n"
"  clean                 was aufgeräumt werden kann und wie viel Platz das schafft\n"
"                        (zeigt die Befehle; es wird nichts entfernt)\n"
"  history               was installiert, aktualisiert oder entfernt wurde   --days N\n"
"  export FILE           die Liste als .csv, .json oder .txt speichern\n"
"  backup FILE           deine installierten Apps für einen neuen Computer speichern\n"
"                        (schreibt auch FILE.sh, ein Skript, das sie neu installiert)\n"
"  restore FILE          zeigen, was auf diesem Computer fehlt   --install zum Installieren\n"
"\n"
"  --check-updates       einmal prüfen und über neue Updates benachrichtigen (für Timer)\n"
"  --install-desktop     URPM zu deinem App-Menü hinzufügen (für pip-/pipx-Installationen)\n"
"  --uninstall-desktop   wieder aus deinem App-Menü entfernen\n"
"  --version             die Version ausgeben\n"
"  -h, --help            diese Hilfe anzeigen\n"

