#: urpm/cli.py
#, python-brace-format
msgid ""
"URPM {version}: every package on your computer, in one place\n"
"\n"
"usage: urpm [command] [options]\n"
"\n"
"  (no command)          open the URPM window\n"
"  list                  list packages   --mine  --updates  --source ID  --json\n"
"  search WORDS…         find packages by name or description\n"
"  info NAME             everything about one package\n"
"  updates               check for updates (🛡 marks security fixes)\n"
"  dupes                 apps installed more than once\n"
"  clean                 what can be cleaned up and how much space it frees\n"
"                        (shows the commands; nothing is removed)\n"
"  history               what was installed, updated or removed   --days N\n"
"  export FILE           save the list as .csv, .json or .txt\n"
"  backup FILE           save the apps you installed, to move to a new computer\n"
"                        (also writes FILE.sh, a script that reinstalls them)\n"
"  restore FILE          show what's missing on this computer   --install to install it\n"
"\n"
"  --check-updates       check once and notify about new updates (for timers)\n"
"  --install-desktop     add URPM to your app menu (for pip / pipx installs)\n"
"  --uninstall-desktop   remove it from your app menu again\n"
"  --version             print the version\n"
"  -h, --help            show this help\n"
msgstr ""
"URPM {version} : tous les paquets de votre ordinateur, au même endroit\n"
"\n"
"utilisation : urpm [commande] [options]\n"
"\n"
"  (sans commande)       ouvre la fenêtre d'URPM\n"
"  list                  liste les paquets   --mine  --updates  --source ID  --json\n"
"  search WORDS…         cherche des paquets par nom ou description\n"
"  info NAME             tout sur un paquet\n"
"  updates               cherche des mises à jour (🛡 signale les correctifs de sécurité)\n"
"  dupes                 applications installées plusieurs fois\n"
"  clean                 ce qui peut être nettoyé et l'espace que cela libère\n"
"                        (affiche les commandes ; rien n'est supprimé)\n"
"  history               ce qui a été installé, mis à jour ou supprimé   --days N\n"
"  export FILE           enregistre la liste en .csv, .json ou .txt\n"
"  backup FILE           enregistre vos applications pour un nouvel ordinateur\n"
"                        (crée aussi FILE.sh, un script qui les réinstalle)\n"
"  restore FILE          affiche ce qui manque sur cet ordinateur   --install pour l'installer\n"
"\n"
"  --check-updates       vérifie une fois et signale les nouvelles mises à jour (pour les tâches planifiées)\n"
"  --install-desktop     ajoute URPM au menu des applications (installations pip / pipx)\n"
"  --uninstall-desktop   le retire à nouveau du menu des applications\n"
"  --version             affiche la version\n"
"  -h, --help            affiche cette aide\n"

