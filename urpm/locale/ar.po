#: urpm/cleanup.py
msgid "pip download cache"
msgstr "ذاكرة تنزيلات pip المؤقتة"

#: urpm/cleanup.py
msgid "Python packages pip downloaded before. They'll be downloaded again if you install them later."
msgstr "حزم Python التي نزّلها pip سابقًا. ستُنزَّل من جديد إن ثبّتّها لاحقًا."

#: urpm/cleanup.py
msgid "npm download cache"
msgstr "ذاكرة تنزيلات npm المؤقتة"

#: urpm/cleanup.py
msgid "Copies of every package npm has downloaded. npm fetches them again when a project needs them."
msgstr "نسخ من كل حزمة نزّلها npm. يجلبها npm مجددًا عندما يحتاجها مشروع ما."

#: urpm/cleanup.py
msgid "Cargo download cache"
msgstr "ذاكرة تنزيلات Cargo المؤقتة"

#: urpm/cleanup.py
msgid "Downloaded crates and their unpacked sources. Cargo downloads them again when a project needs them."
msgstr "حزم crates المنزّلة ومصادرها المفكوكة. ينزّلها Cargo مجددًا عندما يحتاجها مشروع ما."

#: urpm/cleanup.py
msgid "Old Homebrew versions and downloads"
msgstr "إصدارات Homebrew القديمة وتنزيلاته"

#: urpm/cleanup.py
msgid "Older versions of upgraded formulae and cached downloads."
msgstr "الإصدارات القديمة من الصيغ المُحدَّثة، والتنزيلات المخزّنة مؤقتًا."

#: urpm/cli.py
#, python-brace-format
msgid ""
"URPM {version}: every package on your computer, in one place\n"
"\n"
"usage: urpm [command] [options]\n"
"\n"
"  (no command)          open the URPM window\n"
"  list                  list packages   --mine  --updates  --source ID  --json\n"
"  search WORDS…         find packages by name or description\n"
"  info NAME             everything about one package\n"
"  updates               check for updates (🛡 marks security fixes)\n"
"  dupes                 apps installed more than once\n"
"  clean                 what can be cleaned up and how much space it frees\n"
"                        (shows the commands; nothing is removed)\n"
"  history               what was installed, updated or removed   --days N\n"
"  export FILE           save the list as .csv, .json or .txt\n"
"  backup FILE           save the apps you installed, to move to a new computer\n"
"                        (also writes FILE.sh, a script that reinstalls them)\n"
"  restore FILE          show what's missing on this computer   --install to install it\n"
"\n"
"  --check-updates       check once and notify about new updates (for timers)\n"
"  --install-desktop     add URPM to your app menu (for pip / pipx installs)\n"
"  --uninstall-desktop   remove it from your app menu again\n"
"  --version             print the version\n"
"  -h, --help            show this help\n"
msgstr ""
"URPM {version}: كل حزمة على حاسوبك، في مكان واحد\n"
"\n"
"الاستخدام: urpm [أمر] [خيارات]\n"
"\n"
"  (بلا أمر)             فتح نافذة URPM\n"
"  list                  عرض الحزم   --mine  --updates  --source ID  --json\n"
"  search WORDS…         البحث عن الحزم بالاسم أو الوصف\n"
"  info NAME             كل شيء عن حزمة واحدة\n"
"  updates               التحقق من التحديثات (🛡 تشير إلى الإصلاحات الأمنية)\n"
"  dupes                 التطبيقات المثبّتة أكثر من مرة\n"
"  clean                 ما يمكن تنظيفه وكم من المساحة يحرّر\n"
"                        (يعرض الأوامر فقط؛ لا يُحذف شيء)\n"
"  history               ما ثُبّت أو حُدّث أو أُزيل   --days N\n"
"  export FILE           حفظ القائمة بصيغة .csv أو .json أو .txt\n"
"  backup FILE           حفظ التطبيقات التي ثبّتّها، لنقلها إلى حاسوب جديد\n"
"                        (ويكتب أيضًا FILE.sh، وهو سكربت يعيد تثبيتها)\n"
"  restore FILE          عرض ما ينقص على هذا الحاسوب   --install لتثبيته\n"
"\n"
"  --check-updates       التحقق مرة واحدة والتنبيه بالتحديثات الجديدة (للمؤقّتات)\n"
"  --install-desktop     إضافة URPM إلى قائمة التطبيقات (لتثبيتات pip / pipx)\n"
"  --uninstall-desktop   إزالته من قائمة التطبيقات مجددًا\n"
"  --version             طباعة رقم الإصدار\n"
"  -h, --help            عرض هذه المساعدة\n"

