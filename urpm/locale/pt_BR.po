#: urpm/cli.py
#, python-brace-format
msgid ""
"URPM {version}: every package on your computer, in one place\n"
"\n"
"usage: urpm [command] [options]\n"
"\n"
"  (no command)          open the URPM window\n"
"  list                  list packages   --mine  --updates  --source ID  --json\n"
"  search WORDS…         find packages by name or description\n"
"  info NAME             everything about one package\n"
"  updates               check for updates (🛡 marks security fixes)\n"
"  dupes                 apps installed more than once\n"
"  clean                 what can be cleaned up and how much space it frees\n"
"                        (shows the commands; nothing is removed)\n"
"  history               what was installed, updated or removed   --days N\n"
"  export FILE           save the list as .csv, .json or .txt\n"
"  backup FILE           save the apps you installed, to move to a new computer\n"
"                        (also writes FILE.sh, a script that reinstalls them)\n"
"  restore FILE          show what's missing on this computer   --install to install it\n"
"\n"
"  --check-updates       check once and notify about new updates (for timers)\n"
"  --install-desktop     add URPM to your app menu (for pip / pipx installs)\n"
"  --uninstall-desktop   remove it from your app menu again\n"
"  --version             print the version\n"
"  -h, --help            show this help\n"
msgstr ""
"URPM {version}: todos os pacotes do seu computador, em um só lugar\n"
"\n"
"uso: urpm [comando] [opções]\n"
"\n"
"  (sem comando)         abre a janela do URPM\n"
"  list                  lista os pacotes   --mine  --updates  --source ID  --json\n"
"  search WORDS…         procura pacotes pelo nome ou pela descrição\n"
"  info NAME             tudo sobre um pacote\n"
"  updates               procura atualizações (🛡 indica correções de segurança)\n"
"  dupes                 aplicativos instalados mais de uma vez\n"
"  clean                 o que pode ser limpo e quanto espaço isso libera\n"
"                        (mostra os comandos; nada é removido)\n"
"  history               o que foi instalado, atualizado ou removido   --days N\n"
"  export FILE           salva a lista como .csv, .json ou .txt\n"
"  backup FILE           salva os aplicativos que você instalou, para levar a um computador novo\n"
"                        (também cria FILE.sh, um script que os reinstala)\n"
"  restore FILE          mostra o que falta neste computador   --install para instalar\n"
"\n"
"  --check-updates       verifica uma vez e avisa sobre novas atualizações (para timers)\n"
"  --install-desktop     adiciona o URPM ao menu de aplicativos (para instalações via pip / pipx)\n"
"  --uninstall-desktop   remove o URPM do menu de aplicativos\n"
"  --version             mostra a versão\n"
"  -h, --help            mostra esta ajuda\n"

